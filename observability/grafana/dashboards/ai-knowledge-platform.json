{
  "id": null,
  "uid": "ai-knowledge-platform",
  "title": "AI Knowledge Platform",
  "tags": ["aikp", "rag", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Requests / min", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(aikp_http_server_request_count_total[5m])) * 60", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqpm"}, "overrides": []}},
    {"id": 2, "type": "stat", "title": "API P95 latency", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(aikp_http_server_request_duration_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2}, "overrides": []}},
    {"id": 3, "type": "stat", "title": "API 5xx rate", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * sum(rate(aikp_http_server_request_count_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(aikp_http_server_request_count_total[5m])), 1e-9)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2}, "overrides": []}},
    {"id": 4, "type": "stat", "title": "LLM failure rate", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * sum(rate(aikp_llm_request_count_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(aikp_llm_request_count_total[5m])), 1e-9)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2}, "overrides": []}},
    {"id": 5, "type": "stat", "title": "LLM TTFT P95", "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(aikp_llm_time_to_first_token_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2}, "overrides": []}},
    {"id": 6, "type": "stat", "title": "Retrieval P95", "gridPos": {"x": 6, "y": 4, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(aikp_rag_retrieval_duration_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}, "overrides": []}},
    {"id": 7, "type": "stat", "title": "Ingestion queue", "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "max(aikp_worker_queue_depth{messaging_destination_name=\"ingestion\"})", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 8, "type": "stat", "title": "Research queue", "gridPos": {"x": 18, "y": 4, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "max(aikp_worker_queue_depth{messaging_destination_name=\"research\"})", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 9, "type": "timeseries", "title": "Requests by route", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (http_route) (rate(aikp_http_server_request_count_total[5m]))", "legendFormat": "{{http_route}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "Model generation P95 by provider and model", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, gen_ai_provider_name, gen_ai_request_model) (rate(aikp_llm_generation_duration_seconds_bucket[5m])))", "legendFormat": "{{gen_ai_provider_name}} / {{gen_ai_request_model}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Token throughput", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (gen_ai_provider_name, gen_ai_request_model, token_type) (rate(aikp_llm_tokens_total[5m]))", "legendFormat": "{{gen_ai_provider_name}} / {{gen_ai_request_model}} / {{token_type}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "tok/s"}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "Worker duration and retries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, messaging_destination_name, worker_job_type) (rate(aikp_worker_job_duration_seconds_bucket[5m])))", "legendFormat": "P95 {{messaging_destination_name}} / {{worker_job_type}}", "refId": "A"}, {"expr": "sum by (messaging_destination_name, worker_job_type) (rate(aikp_worker_job_retries_total[5m]))", "legendFormat": "Retries {{messaging_destination_name}} / {{worker_job_type}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 13, "type": "timeseries", "title": "Container CPU", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".*(backend|worker|dispatcher).*\"}[5m]))", "legendFormat": "{{name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}},
    {"id": 14, "type": "timeseries", "title": "Container memory", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "container_memory_working_set_bytes{name=~\".*(backend|worker|dispatcher).*\"}", "legendFormat": "{{name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 15, "type": "timeseries", "title": "GPU utilization (enable gpu profile)", "gridPos": {"x": 0, "y": 40, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}},
    {"id": 16, "type": "timeseries", "title": "GPU memory (enable gpu profile)", "gridPos": {"x": 12, "y": 40, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "DCGM_FI_DEV_FB_USED * 1024 * 1024", "legendFormat": "GPU {{gpu}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 17, "type": "traces", "title": "Recent traces", "gridPos": {"x": 0, "y": 56, "w": 24, "h": 10}, "datasource": {"type": "tempo", "uid": "tempo"}, "targets": [{"queryType": "traceqlSearch", "query": "{ resource.service.namespace = \"ai-knowledge-platform\" }", "refId": "A"}], "options": {}},
    {"id": 18, "type": "timeseries", "title": "Failed and retried worker jobs", "gridPos": {"x": 0, "y": 48, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (messaging_destination_name, worker_job_type) (rate(aikp_worker_jobs_count_total{outcome=\"failed\"}[5m]))", "legendFormat": "Failed {{messaging_destination_name}} / {{worker_job_type}}", "refId": "A"}, {"expr": "sum by (messaging_destination_name, worker_job_type) (rate(aikp_worker_job_retries_total[5m]))", "legendFormat": "Retries {{messaging_destination_name}} / {{worker_job_type}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 19, "type": "timeseries", "title": "Research stage P95", "gridPos": {"x": 12, "y": 48, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, research_stage) (rate(aikp_research_stage_duration_seconds_bucket[5m])))", "legendFormat": "{{research_stage}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 20, "type": "stat", "title": "API P50 latency", "gridPos": {"x": 0, "y": 32, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(aikp_http_server_request_duration_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2}, "overrides": []}},
    {"id": 21, "type": "timeseries", "title": "Embedding latency", "gridPos": {"x": 6, "y": 32, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(aikp_embedding_duration_seconds_bucket[5m])))", "legendFormat": "P95", "refId": "A"}, {"expr": "sum by (model) (rate(aikp_embedding_vectors_total[5m]))", "legendFormat": "{{model}} vectors/s", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}}
  ]
}
