# Copy to .env.production. Compose reads this as --env-file; never commit the filled file.
APP_DOMAIN=knowledge.example.com
S3_BUCKET=knowledge-pdfs
BACKUP_BUCKET=knowledge-db-backups
S3_REGION=us-east-1
# Set only for an S3-compatible endpoint outside the VPS.
S3_ENDPOINT_URL=
# Configure a reachable model endpoint or enable the local-model profile.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=
CHAT_PROVIDER=
CHAT_MODEL=
RESEARCH_PLAN_PROVIDER=
RESEARCH_PLAN_MODEL=
RESEARCH_DRAFT_PROVIDER=
RESEARCH_DRAFT_MODEL=
OTEL_ENABLED=false
