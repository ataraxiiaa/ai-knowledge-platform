# Database (PostgreSQL / Supabase / Neon / SQLite)
# Leave unset for the local backend/app.db SQLite database.
# DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_platform

# Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 3 requires a PostgreSQL database with the vector extension available.
# Use persistent directories for deployed uploads and downloaded model files.
# UPLOAD_DIR=/var/data/uploads
# EMBEDDING_CACHE_DIR=/var/data/models
EMBEDDING_THREADS=2
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE=1024
CHUNK_OVERLAP=64
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100

# Phase 4: OpenAI-compatible chat completions with JSON mode.
# Questions and retrieved passages are sent to this endpoint. Keep keys server-side.
# For local Ollama, set LLM_MODEL to an installed model (for example llama3.1:8b).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Phase 9 task routing. Blank task settings inherit LLM_MODEL and the
# OpenAI-compatible endpoint above (OpenAI, Ollama, or vLLM).
CHAT_PROVIDER=
CHAT_MODEL=
RESEARCH_PLAN_PROVIDER=
RESEARCH_PLAN_MODEL=
RESEARCH_DRAFT_PROVIDER=
RESEARCH_DRAFT_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
MODEL_FALLBACK_PROVIDER=
MODEL_FALLBACK_MODEL=
GATEWAY_MAX_ATTEMPTS=2
GATEWAY_RETRY_BASE_SECONDS=0.5
# Set to max_completion_tokens for OpenAI models that do not accept max_tokens.
OPENAI_TOKEN_LIMIT_FIELD=max_tokens
RAG_TOP_K=5
# Phase 6 worker infrastructure. Compose uses redis://redis:6379/0 internally.
REDIS_URL=redis://127.0.0.1:6379/0
# Optional single-web-service test mode: processes durable jobs without Redis.
# Use only with one API process and local PDFs; files disappear on free Render restarts.
WEB_LOCAL_JOBS=false
# Supabase Storage uses the S3-compatible protocol (private bucket, server-side keys):
# STORAGE_BACKEND=s3
# S3_BUCKET=private-pdfs
# S3_REGION=<region shown in Supabase Storage S3 settings>
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_ACCESS_KEY_ID=<Supabase Storage S3 access key>
# AWS_SECRET_ACCESS_KEY=<Supabase Storage S3 secret key>
CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_TTL_SECONDS=300
CHAT_CACHE_TTL_SECONDS=300
CACHE_MAX_VALUE_BYTES=524288
# Estimated USD per million tokens, keyed by provider:model.
# CACHE_MODEL_PRICES_JSON={"openai_compatible:your-model":{"input":0.15,"output":0.60}}
RQ_QUEUE_NAME=ingestion
RQ_JOB_TIMEOUT=900
INGESTION_MAX_ATTEMPTS=3
RESEARCH_QUEUE_NAME=research
RESEARCH_JOB_TIMEOUT=3600
RESEARCH_MAX_ATTEMPTS=3
# BM25 rebuilds a workspace-scoped in-memory index per request; fail above this cap.
BM25_MAX_CHUNKS=20000
# Hybrid retrieves this many candidates from EACH branch before merging.
HYBRID_CANDIDATES=20
HYBRID_RRF_K=60
# Rerank the best fused candidates with a local CPU cross-encoder.
RERANK_CANDIDATES=20
RERANK_THREADS=2
# RERANK_CACHE_DIR=/var/data/rerankers
# Chat defaults to vector; opt into bm25, hybrid, or hybrid_reranked explicitly.
RAG_RETRIEVAL_METHOD=vector

# Phase 11 OpenTelemetry and local Grafana stack
OTEL_ENABLED=true
OTEL_ENVIRONMENT=local
GRAFANA_ADMIN_USER=admin
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRAFANA_ADMIN_PASSWORD=
