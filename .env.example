# Database (PostgreSQL / Supabase / Neon / SQLite)
# Leave unset for the local backend/app.db SQLite database.
# DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_platform

# Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 3 requires a PostgreSQL database with the vector extension available.
# Use persistent directories for deployed uploads and downloaded model files.
# UPLOAD_DIR=/var/data/uploads
# EMBEDDING_CACHE_DIR=/var/data/models
EMBEDDING_THREADS=2
CHUNK_SIZE=1024
CHUNK_OVERLAP=64
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100

# Phase 4: OpenAI-compatible chat completions with JSON mode.
# Questions and retrieved passages are sent to this endpoint. Keep keys server-side.
# For local Ollama, set LLM_MODEL to an installed model (for example llama3.1:8b).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
RAG_TOP_K=5
